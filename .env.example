# Copy to .env and fill in. .env is git-ignored — never commit real values.

APP_ENV=local
APP_DEBUG=false
APP_URL=https://pixelite.cz
APP_LOCALE=en

# Telegram Bot API. Create a bot with @BotFather, then get the chat id by
# messaging the bot and reading https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10

# Company identification – shown in the footer, privacy policy and terms exactly as written here.
COMPANY_NAME=
COMPANY_ICO=
COMPANY_ADDRESS=
# Optional: VAT ID and a free-text registration note (e.g. which register you are entered in).
COMPANY_DIC=
COMPANY_REGISTER=

# Public contact details. Left empty, the site shows a clearly marked
# "not configured" placeholder instead of inventing an address.
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_LOCATION=

# Contact form rate limiting: attempts per window, window in seconds.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=900

# Set to true only when running behind a proxy you control, otherwise
# X-Forwarded-For can be spoofed to bypass the rate limiter.
TRUST_PROXY=false

# Defaults to storage/leads.sqlite.
LEADS_DATABASE_PATH=

# --- Staff area (/admin) ---------------------------------------------------
# Single staff login. Generate the hash with:
#   docker compose run --rm app php bin/hash-password.php
# and paste it SINGLE-QUOTED (bcrypt hashes contain `$`):
#   ADMIN_PASSWORD_HASH='$2y$10$...'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Only change for testing against a fake Telegram server.
# TELEGRAM_API_BASE=https://api.telegram.org
