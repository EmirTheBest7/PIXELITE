# Copy to .env and fill in. .env is git-ignored — never commit real values.

APP_ENV=local
APP_DEBUG=false
APP_URL=https://pixelite.cz
APP_LOCALE=en

# Telegram Bot API. Create a bot with @BotFather, then get the chat id by
# messaging the bot and reading https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10

# Company identification – shown in the footer, privacy policy and terms exactly as written here.
COMPANY_NAME=
COMPANY_ICO=
COMPANY_ADDRESS=
# Optional: VAT ID and a free-text registration note (e.g. which register you are entered in).
COMPANY_DIC=
COMPANY_REGISTER=

# Public contact details. Left empty, the site shows a clearly marked
# "not configured" placeholder instead of inventing an address.
# How the public prices relate to VAT (DPH). Set ONLY to what is true for the company:
#   incl = prices include VAT   excl = prices exclude VAT   none = not a VAT payer, no VAT is added
# Left empty, the pricing cards and /terms show a visible "to be completed" placeholder instead of guessing.
PRICE_VAT_MODE=

CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_LOCATION=

# Contact form rate limiting: attempts per window, window in seconds.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=900

# Set to true only when running behind a proxy you control, otherwise
# X-Forwarded-For can be spoofed to bypass the rate limiter.
TRUST_PROXY=false

# Defaults to storage/leads.sqlite.
LEADS_DATABASE_PATH=

# --- Staff area (/admin) ---------------------------------------------------
# Single staff login. Generate the hash with:
#   docker compose run --rm app php bin/hash-password.php
# and paste it SINGLE-QUOTED (bcrypt hashes contain `$`):
#   ADMIN_PASSWORD_HASH='$2y$10$...'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Only change for testing against a fake Telegram server.
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Client project previews (/admin/projects) -----------------------------
# A preview runs ARBITRARY HTML/JavaScript from a client, so it must be served from a
# DIFFERENT HOST than the main site (cookies are per host; a different port or path is
# NOT isolation). Point a separate (sub)domain at the SAME web root, e.g.
#   PREVIEW_ORIGIN=https://preview.pixelite.cz
# That host serves only /p/<token>/… (no site pages, admin, login or cookies). Leave it
# empty (the default) to keep previews OFF: projects and uploads still work, links stay
# hidden. It is refused if it has the same host as APP_URL. Never set a cookie Domain.
PREVIEW_ORIGIN=

# Optional: where project files are stored (default storage/projects, outside the web root).
# PROJECTS_DIR=
# Uploads are also limited by the host's PHP settings (upload_max_filesize, post_max_size).

# Which presentation is served at the normal URLs: new (default) or legacy. The other one is available under /legacy (or /new).
# DESIGN_DEFAULT=legacy is a no-deploy rollback to the previous design.
# DESIGN_DEFAULT=new

# EXPERIMENTAL visual editor (src/Editor/): off unless true. While off, every /editor/... URL is a 404.
# EDITOR_ENABLED=false

# PUBLIC site builder at /<lang>/builder (no account; temporary per-visitor workspaces, deleted after 24 h without activity). ON by default.
# BUILDER_PUBLIC=false removes the page, its navigation link and all /builder/w routes. Storage: storage/builder/ (BUILDER_DIR overrides). Needs PHP dom + a writable storage folder;
# image uploads need PHP gd (without it the builder works but refuses uploads).
# BUILDER_PUBLIC=true
# BUILDER_DIR=
